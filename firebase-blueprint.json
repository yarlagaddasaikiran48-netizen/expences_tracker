{
  "entities": {
    "Trip": {
      "title": "Trip",
      "description": "A shared group trip expense ledger containing travelers.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the trip (e.g. Kerala Trip)."
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Destination of the trip."
        },
        "travelers": {
          "type": "array",
          "description": "Bounded list of traveler names sharing expenses (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "name",
        "destination",
        "travelers",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "An individual bill paid during the trip and split among selected travelers.",
      "type": "object",
      "properties": {
        "tripId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent trip document ID."
        },
        "paidBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Name of the traveler who paid the bill."
        },
        "amount": {
          "type": "number",
          "description": "Bill amount in INR (> 0 and <= 10000000)."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Expense category/reason selected from the list."
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180,
          "description": "Optional manual details or custom reason note."
        },
        "splitAmong": {
          "type": "array",
          "description": "Bounded list of traveler names splitting this expense (1 to 20)."
        },
        "expenseDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of expense in YYYY-MM-DD format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "tripId",
        "paidBy",
        "amount",
        "reason",
        "note",
        "splitAmong",
        "expenseDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "SettlementRecord": {
      "title": "SettlementRecord",
      "description": "A recorded settlement payment between two travelers to clear trip balances.",
      "type": "object",
      "properties": {
        "tripId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromPerson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "toPerson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "amount": {
          "type": "number"
        },
        "settledDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tripId",
        "fromPerson",
        "toPerson",
        "amount",
        "settledDate",
        "note",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Shared Kerala trip ledger configuration."
    },
    "/trips/{tripId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Individual expenses paid during the trip."
    },
    "/trips/{tripId}/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/SettlementRecord" },
      "description": "Recorded settlement transfers between travelers."
    }
  }
}
