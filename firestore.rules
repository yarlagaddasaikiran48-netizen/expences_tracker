rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateString(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isBoundedStringList(arr, minLen, maxLen) {
      return arr is list
        && arr.size() >= minLen
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 50));
    }

    function isValidTrip(data) {
      return data.keys().hasAll(['name', 'destination', 'travelers', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'destination', 'travelers', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 80
        && isBoundedStringList(data.travelers, 1, 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, tripId) {
      return data.keys().hasAll([
          'tripId', 'paidBy', 'amount', 'reason', 'note',
          'splitAmong', 'expenseDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tripId', 'paidBy', 'amount', 'reason', 'note',
          'splitAmong', 'expenseDate', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.tripId) && data.tripId == tripId
        && data.paidBy is string && data.paidBy.size() >= 1 && data.paidBy.size() <= 50
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 10000000
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 60
        && data.note is string && data.note.size() <= 180
        && isBoundedStringList(data.splitAmong, 1, 20)
        && isValidDateString(data.expenseDate)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSettlement(data, tripId) {
      return data.keys().hasAll([
          'tripId', 'fromPerson', 'toPerson', 'amount',
          'settledDate', 'note', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tripId', 'fromPerson', 'toPerson', 'amount',
          'settledDate', 'note', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.tripId) && data.tripId == tripId
        && data.fromPerson is string && data.fromPerson.size() >= 1 && data.fromPerson.size() <= 50
        && data.toPerson is string && data.toPerson.size() >= 1 && data.toPerson.size() <= 50
        && data.fromPerson != data.toPerson
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 10000000
        && isValidDateString(data.settledDate)
        && data.note is string && data.note.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function parentTripExists(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId));
    }

    match /trips/{tripId} {
      allow get: if isValidId(tripId);
      allow list: if false;

      allow create: if isValidId(tripId)
        && isValidTrip(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(tripId)
        && isValidTrip(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'destination', 'travelers', 'updatedAt']);

      allow delete: if false;

      match /expenses/{expenseId} {
        allow get: if isValidId(tripId) && isValidId(expenseId) && parentTripExists(tripId);
        allow list: if isValidId(tripId) && resource.data.tripId == tripId;

        allow create: if isValidId(tripId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), tripId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentTripExists(tripId);

        allow update: if isValidId(tripId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), tripId)
          && incoming().tripId == existing().tripId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentTripExists(tripId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'paidBy', 'amount', 'reason', 'note', 'splitAmong', 'expenseDate', 'updatedAt'
          ]);

        allow delete: if isValidId(tripId) && isValidId(expenseId) && parentTripExists(tripId);
      }

      match /settlements/{settlementId} {
        allow get: if isValidId(tripId) && isValidId(settlementId) && parentTripExists(tripId);
        allow list: if isValidId(tripId) && resource.data.tripId == tripId;

        allow create: if isValidId(tripId)
          && isValidId(settlementId)
          && isValidSettlement(incoming(), tripId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentTripExists(tripId);

        allow update: if false;

        allow delete: if isValidId(tripId) && isValidId(settlementId) && parentTripExists(tripId);
      }
    }
  }
}
